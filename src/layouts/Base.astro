---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site.js";

const { title, description, ogType = "website", jsonld = [], current = "", includeBase = true } = Astro.props;
const origin = Astro.site.href.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = origin + "/og.png";

const base = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": origin + "/#website", url: origin + "/", name: SITE.name, inLanguage: "en-AU" },
    {
      "@type": "Person",
      "@id": origin + "/#person",
      name: SITE.name,
      givenName: SITE.givenName,
      familyName: SITE.familyName,
      jobTitle: SITE.jobTitle,
      description: SITE.description,
      url: origin + "/",
      email: "mailto:" + SITE.email,
      address: { "@type": "PostalAddress", addressLocality: SITE.city, addressRegion: SITE.region, addressCountry: SITE.country },
      sameAs: [SITE.linkedin],
    },
  ],
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono:wght@500&display=swap" />
    {includeBase && <script type="application/ld+json" set:html={JSON.stringify(base)} />}
    {jsonld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <slot name="head" />
  </head>
  <body>
    <Header current={current} />
    <slot />
    <Footer />
    <slot name="scripts" />
  </body>
</html>
