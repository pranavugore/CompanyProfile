---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, org } from "../data/site.js";

const { title, description, ogType = "website", jsonld = [], current = "", includeBase = true, updated = SITE.updated } = Astro.props;
const origin = Astro.site.href.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = origin + "/og.png";
// Every built page except 404 also gets a Markdown copy at <page>/index.md (see integrations/agent-files.mjs).
const markdownHref = Astro.url.pathname.startsWith("/404") ? null : canonical + "index.md";

const base = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": origin + "/#website", url: origin + "/", name: SITE.brand, publisher: { "@id": origin + "/#org" }, inLanguage: "en-AU" },
    org(origin),
    {
      "@type": "Person",
      "@id": origin + "/#person",
      name: SITE.name,
      givenName: SITE.givenName,
      familyName: SITE.familyName,
      jobTitle: SITE.jobTitle,
      description: SITE.description,
      url: origin + "/",
      email: "mailto:" + SITE.email,
      address: { "@type": "PostalAddress", addressLocality: SITE.city, addressRegion: SITE.region, addressCountry: SITE.country },
      sameAs: [SITE.linkedin],
      worksFor: { "@id": origin + "/#org" },
    },
  ],
};

// Stamp dateModified on the page's own node (WebPage, ProfilePage, AboutPage...), or add a
// WebPage node when the page doesn't have one, so answer engines can see how fresh it is.
const PAGE_TYPES = ["WebPage", "ProfilePage", "AboutPage", "CollectionPage", "FAQPage", "ContactPage"];
const nodes = [...jsonld, ...(includeBase ? [base] : [])].flatMap((o) => o["@graph"] || [o]);
const pageNode = nodes.find((n) => PAGE_TYPES.includes(n["@type"]) && n["@type"] !== "FAQPage");
if (pageNode) pageNode.dateModified = updated;
else if (includeBase) base["@graph"].push({ "@type": "WebPage", "@id": canonical + "#webpage", url: canonical, name: title, description, isPartOf: { "@id": origin + "/#website" }, about: { "@id": origin + "/#org" }, inLanguage: "en-AU", dateModified: updated });
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} title="This page as Markdown" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.brand + " (studionarrm.com) logo"} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:updated_time" content={updated} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono:wght@500&display=swap" />
    {includeBase && <script type="application/ld+json" set:html={JSON.stringify(base)} />}
    {jsonld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <slot name="head" />
  </head>
  <body>
    <Header current={current} />
    <slot />
    <Footer updated={updated} />
    <slot name="scripts" />
  </body>
</html>
