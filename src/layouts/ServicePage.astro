---
import Base from "./Base.astro";
import ServiceArt from "../components/ServiceArt.astro";
import { SERVICES } from "../data/services.js";
import { SITE } from "../data/site.js";
const { slug } = Astro.props;
const s = SERVICES.find((x) => x.slug === slug);
const plain = (h) => h.replace(/<[^>]+>/g, "");
const origin = Astro.site.href.replace(/\/$/, "");
const url = origin + s.href;
const title = `${s.eyebrow} | ${SITE.name}, ${SITE.city}`;
const description = s.summary;
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: s.eyebrow,
    serviceType: s.eyebrow,
    description: s.page.lead,
    url,
    provider: { "@id": origin + "/#person" },
    areaServed: [{ "@type": "Country", name: "Australia" }, "Remote worldwide"],
    hasOfferCatalog: { "@type": "OfferCatalog", name: s.eyebrow, itemListElement: s.page.offer.map(([n, d]) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: n, description: d } })) },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: origin + "/" },
      { "@type": "ListItem", position: 2, name: s.eyebrow, item: url },
    ],
  },
];
const others = SERVICES.filter((x) => x.slug !== slug);
const steps = [
  ["Understand", "A short call to learn what you need, who it's for and what good looks like."],
  ["Plan", "A simple written plan with scope, timeline and a fixed price where possible."],
  ["Build", "Working pieces early and often, so you can react before anything is final."],
  ["Hand over", "Documentation, a walkthrough and support while it beds in."],
];
---
<Base title={title} description={description} jsonld={jsonld} current={slug}>
  <main class={`svc ${s.tone}`}>
    <section class="svc-hero">
      <div class="wrap">
        <div class="text">
          <nav class="crumbs mono" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/#services">Services</a> / <span>{s.eyebrow}</span></nav>
          <p class="kicker">{s.kicker}</p>
          <span class="eyebrow">{s.eyebrow}</span>
          <h1 class="caps" set:html={s.title} />
          <p class="lead">{s.page.lead}</p>
          <div class="cta"><a class="btn tone" href="/#contact">Start a conversation</a><a class="btn ghost" href="#what">What I can do</a></div>
        </div>
        <ServiceArt name={s.art} />
      </div>
    </section>

    <section class="section" id="what" aria-labelledby="what-h">
      <div class="wrap">
        <div class="section-head"><div><span class="eyebrow">What I can do</span><h2 id="what-h">{plain(s.title)}, end to end</h2></div></div>
        <ul class="offer">
          {s.page.offer.map(([n, d], k) => <li class="reveal"><span class="n mono">{String(k + 1).padStart(2, "0")}</span><h3>{n}</h3><p>{d}</p></li>)}
        </ul>
        {s.page.products && <p class="note">{s.page.products}</p>}
      </div>
    </section>

    {s.page.second && (
      <section class="section svc-second" aria-label="Example">
        <div class="wrap">
          <ServiceArt name={s.page.second} tone={s.tone} />
          <p class="caption">{s.page.secondCaption}</p>
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="how-h">
      <div class="wrap">
        <div class="section-head"><div><span class="eyebrow">How it works</span><h2 id="how-h">Simple, visible, no surprises</h2></div></div>
        <ol class="steps four">
          {steps.map(([h, p], k) => <li class="reveal"><span class="n">{String(k + 1).padStart(2, "0")}</span><h3>{h}</h3><p>{p}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="section others" aria-labelledby="others-h">
      <div class="wrap">
        <h2 id="others-h">Other ways I can help</h2>
        <ul>
          {others.map((o) => <li><a class={o.tone} href={o.href}><span>{o.eyebrow}</span><span aria-hidden="true">→</span></a></li>)}
        </ul>
      </div>
    </section>

    <section class="svc-cta">
      <div class="wrap">
        <h2>Have something in mind?</h2>
        <p>Tell me what you're trying to do. I'll reply with a straight answer on whether I can help and what it would take.</p>
        <a class="btn" href={"mailto:" + SITE.email + "?subject=" + encodeURIComponent(s.eyebrow)}>Email me</a>
      </div>
    </section>
  </main>
</Base>
