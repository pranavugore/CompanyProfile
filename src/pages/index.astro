---
import Base from "../layouts/Base.astro";
import ServicePanel from "../components/ServicePanel.astro";
import { SERVICES } from "../data/services.js";
const origin = Astro.site.href.replace(/\/$/, "");
const title = "Pranav Gore | Solution Architect, Data & Automation, Melbourne";
const description = "Pranav Gore is a Melbourne-based Solution Architect with 19 years in enterprise integration, data analytics dashboards AI agents and n8n workflow automation for banking, telecom and non-profits.";
const jsonld = [{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${origin}/#website`,
      "url": `${origin}/`,
      "name": "Pranav Gore",
      "inLanguage": "en-AU"
    },
    {
      "@type": "ProfilePage",
      "@id": `${origin}/#profile`,
      "url": `${origin}/`,
      "isPartOf": {
        "@id": `${origin}/#website`
      },
      "dateModified": "2026-10-11",
      "mainEntity": {
        "@id": `${origin}/#person`
      }
    },
    {
      "@type": "Person",
      "@id": `${origin}/#person`,
      "name": "Pranav Gore",
      "givenName": "Pranav",
      "familyName": "Gore",
      "jobTitle": "Solution Architect",
      "description": "Solution Designer and Architect with 19 years of experience building enterprise applications, integrations, data analytics solutions and workflow automation.",
      "url": `${origin}/`,
      "email": "mailto:pranavugore@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Melbourne",
        "addressRegion": "VIC",
        "addressCountry": "AU"
      },
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "NMAM Institute of Technology (Visvesvaraya Technological University)"
      },
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "name": "AWS Certified Solutions Architect – Associate",
          "credentialCategory": "certification"
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "SAFe Scrum Master",
          "credentialCategory": "certification"
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "ITIL Foundation",
          "credentialCategory": "certification"
        }
      ],
      "knowsAbout": [
        "Solution architecture",
        "System design",
        "Enterprise integration",
        "Microservices",
        "Event-driven architecture",
        "Apache Kafka",
        "IBM MQ",
        "Spring Boot",
        "AWS",
        "Open Banking",
        "Master data management",
        "Data analytics",
        "Dashboards",
        "Looker Studio",
        "Workflow automation",
        "n8n",
        "AI agents",
        "Large language models",
        "Anthropic Claude API",
        "ETL",
        "PostgreSQL",
        "REST APIs",
        "Robotic process automation",
        "Low-code development",
        "Google AppSheet",
        "AI-assisted software development",
        "Claude Code",
        "Cursor",
        "Oracle OSM",
        "Oracle UIM",
        "Order management and fulfilment",
        "Machine learning",
        "Agile delivery",
        "SAFe",
        "Product design",
        "Full-stack development",
        "Mobile app development"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/pranavugore"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${origin}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is Pranav Gore?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pranav Gore is a Melbourne-based Solution Designer and Architect with 19 years of experience designing enterprise applications, system integrations, data analytics solutions and workflow automation across banking, telecommunications, retail and non-profit organisations."
          }
        },
        {
          "@type": "Question",
          "name": "What does Pranav Gore specialise in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solution architecture for complex enterprise systems: integration and microservices design, data migration and master data, analytics dashboards, and end-to-end workflow automation using n8n, AI agents built on large language models, AppSheet and AI-assisted development."
          }
        },
        {
          "@type": "Question",
          "name": "What has Pranav Gore built end to end?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A data analytics web app, more than 50 n8n automations and AI agents, low-code AppSheet apps, the migration of more than 100 RPA robots in-house at Telstra, and two products in progress: the Stolen Minutes app and a platform for yoga teachers."
          }
        },
        {
          "@type": "Question",
          "name": "Which industries has Pranav Gore worked in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Banking and financial services, telecommunications, retail and the non-profit sector, in client-facing roles on large transformation programmes with multiple vendors and geographies."
          }
        },
        {
          "@type": "Question",
          "name": "Can Pranav Gore build automation and analytics for a small team or non-profit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Pranav designs and ships practical, low-maintenance solutions: self-hosted n8n data pipelines, AI agents that research and draft outreach, low-code operational apps and dashboards that turn scattered operational data into decisions."
          }
        },
        {
          "@type": "Question",
          "name": "Is Pranav Gore available for roles or projects?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Pranav is open to Solution Architect and Solution Designer roles and to automation, data and integration projects, based in Melbourne and open to remote work."
          }
        }
      ]
    }
  ]
}];
jsonld.push({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Services",
  itemListElement: SERVICES.map((sv, i) => ({ "@type": "ListItem", position: i + 1, name: sv.eyebrow, url: origin + sv.href })),
});
---
<Base title={title} description={description} jsonld={jsonld} current="home" includeBase={false}>
<main>
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap">
        <div>
          <span class="eyebrow">Systems, Data &amp; Automation</span>
          <p class="kicker">Calmly fixing chaos since 2007…</p>
          <h1 id="hero-h">Messy process in. <span class="hl">Working system</span> out.</h1>
          <p class="lead">I'm Pranav Gore, a Melbourne solution architect who designs <strong>and</strong> builds. Enterprise integrations for banks and telcos, <strong>n8n automations and AI agents</strong>, <strong>dashboards</strong>, <strong>apps</strong>, and a couple of products of my own.</p>
          <div class="cta">
            <a class="btn" href="#contact">Tell me about your problem</a>
            <a class="btn ghost" href="#services">See the work</a>
          </div>
        </div>
        <div class="slider" aria-roledescription="carousel" aria-label="Six areas of work">
          <div class="slides">
