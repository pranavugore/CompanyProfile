---
import Base from "../layouts/Base.astro";
import ServicePanel from "../components/ServicePanel.astro";
import ServiceArt from "../components/ServiceArt.astro";
import { SERVICES, isShown } from "../data/services.js";
import { org } from "../data/site.js";
const NUM = ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight"][SERVICES.length] || String(SERVICES.length);
const origin = Astro.site.href.replace(/\/$/, "");
const title = "Studio Narrm | Data, Automation & AI Agents, Melbourne";
const description = "Studio Narrm is a Melbourne studio for data dashboards, n8n workflow automation, AI agents and custom apps, founded by Pranav Gore, a solution architect with 19 years in banking, telecom and non-profits.";
const jsonld = [{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${origin}/#website`,
      "url": `${origin}/`,
      "name": "Studio Narrm",
      "publisher": {
        "@id": `${origin}/#org`
      },
      "inLanguage": "en-AU"
    },
    org(origin),
    {
      "@type": "ProfilePage",
      "@id": `${origin}/#profile`,
      "url": `${origin}/`,
      "isPartOf": {
        "@id": `${origin}/#website`
      },
      "dateModified": "2026-10-21",
      "mainEntity": {
        "@id": `${origin}/#person`
      }
    },
    {
      "@type": "Person",
      "@id": `${origin}/#person`,
      "name": "Pranav Gore",
      "givenName": "Pranav",
      "familyName": "Gore",
      "jobTitle": "Solution Architect",
      "worksFor": {
        "@id": `${origin}/#org`
      },
      "description": "Solution Designer and Architect with 19 years of experience building enterprise applications, integrations, data analytics solutions and workflow automation.",
      "url": `${origin}/`,
      "email": "mailto:pranavugore@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Melbourne",
        "addressRegion": "VIC",
        "addressCountry": "AU"
      },
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "NMAM Institute of Technology (Visvesvaraya Technological University)"
      },
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "name": "AWS Certified Solutions Architect – Associate",
          "credentialCategory": "certification"
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "SAFe Scrum Master",
          "credentialCategory": "certification"
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "ITIL Foundation",
          "credentialCategory": "certification"
        }
      ],
      "knowsAbout": [
        "Solution architecture",
        "System design",
        "Enterprise integration",
        "Microservices",
        "Event-driven architecture",
        "Apache Kafka",
        "IBM MQ",
        "Spring Boot",
        "AWS",
        "Open Banking",
        "Master data management",
        "Data analytics",
        "Dashboards",
        "Looker Studio",
        "Workflow automation",
        "n8n",
        "AI agents",
        "Large language models",
        "Anthropic Claude API",
        "ETL",
        "PostgreSQL",
        "REST APIs",
        "Robotic process automation",
        "Low-code development",
        "Google AppSheet",
        "AI-assisted software development",
        "Claude Code",
        "Cursor",
        "Oracle OSM",
        "Oracle UIM",
        "Order management and fulfilment",
        "Machine learning",
        "Agile delivery",
        "SAFe",
        "Product design",
        "Full-stack development",
        "Mobile app development"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/pranavugore"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${origin}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is behind Studio Narrm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Studio Narrm was founded by Pranav Gore, a Melbourne-based Solution Designer and Architect with 19 years of experience designing enterprise applications, system integrations, data analytics solutions and workflow automation across banking, telecommunications, retail and non-profit organisations."
          }
        },
        {
          "@type": "Question",
          "name": "What does Studio Narrm specialise in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solution architecture for complex enterprise systems: integration and microservices design, data migration and master data, analytics dashboards, and end-to-end workflow automation using n8n, AI agents built on large language models, AppSheet and AI-assisted development."
          }
        },
        {
          "@type": "Question",
          "name": "What has Studio Narrm's founder built end to end?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A data analytics web app, more than 50 n8n automations and AI agents, low-code AppSheet apps, the migration of more than 100 RPA robots in-house at Telstra, and two products in progress: the Stolen Minutes app and a platform for yoga teachers."
          }
        },
        {
          "@type": "Question",
          "name": "Which industries does Studio Narrm know?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Banking and financial services, telecommunications, retail and the non-profit sector. Pranav worked in client-facing roles on large transformation programmes with multiple vendors and geographies."
          }
        },
        {
          "@type": "Question",
          "name": "Can Studio Narrm build automation and analytics for a small team or non-profit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We design and ship practical, low-maintenance solutions: self-hosted n8n data pipelines, AI agents that research and draft outreach, low-code operational apps and dashboards that turn scattered operational data into decisions."
          }
        },
        {
          "@type": "Question",
          "name": "Is Studio Narrm taking on projects?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We take on automation, data, AI agent, app and integration projects, including solution architecture and design engagements. We're based in Melbourne and happy to work remotely."
          }
        }
      ]
    }
  ]
}];
jsonld.push({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Services",
  itemListElement: SERVICES.map((sv, i) => ({ "@type": "ListItem", position: i + 1, name: sv.eyebrow, url: origin + sv.href })),
});
// "Who are you?" section is hidden for now; set to true to bring it back.
const SHOW_WHO = false;
const TAGS = { "data-viz": "Dashboards · Data stories", automation: "n8n · RPA · AI agents", "agent-ready": "AEO · GEO · MCP", "custom-apps": "AppSheet · Web · Mobile", "video-ads": "Script · Edit · Every format", "marketing-outreach": "Research · Outreach · Follow-up" };
---
<Base title={title} description={description} jsonld={jsonld} current="home" includeBase={false}>
<main>
    <section class="hero" aria-labelledby="hero-h">
      <canvas class="net" data-particle-network aria-hidden="true"></canvas>
      <div class="wrap">
        <div>
          <span class="eyebrow">Systems, Data &amp; Automation</span>
          <p class="kicker">Calmly fixing chaos since 2007…</p>
          <h1 id="hero-h"><span class="line">Messy process in.</span> <span class="line"><span class="hl">Working system</span> out.</span></h1>
          <p class="lead">Studio Narrm is a Melbourne studio that designs <strong>and</strong> builds: <strong>n8n automations and AI agents</strong>, <strong>dashboards</strong>, <strong>apps</strong>, and <strong>custom websites</strong>.</p>
          <div class="cta">
            <a class="btn" href="#contact">Tell us about your problem</a>
            <a class="btn ghost" href="#services">See the work</a>
          </div>
        </div>
        <div class="slider" aria-roledescription="carousel" aria-label={NUM + " services"}>
          <div class="slides">
          {SERVICES.map((sv, i) => (
            <figure class={`slide ${sv.tone}${i === 0 ? " on" : ""}`} aria-hidden={i === 0 ? "false" : "true"}>
              <ServiceArt name={sv.art} bare />
              <figcaption><b><a href={"#" + sv.slug}>{sv.eyebrow}</a></b><span class="mono">{TAGS[sv.slug]}</span></figcaption>
            </figure>
          ))}
          </div>
          <div class="slider-ctrl">
            <div class="dots" role="group" aria-label="Choose a slide">{SERVICES.map((sv, i) => <button type="button" aria-label={"Show " + sv.eyebrow} aria-current={i === 0 ? "true" : undefined}></button>)}</div>
            <div class="arrows"><button type="button" data-dir="-1" aria-label="Previous slide">←</button><button type="button" data-dir="1" aria-label="Next slide">→</button></div>
          </div>
        </div>
      </div>
    </section>

    <section class="intro" aria-labelledby="intro-h">
      <div class="wrap">
        <div>
          <span class="eyebrow">Welcome</span>
          <h2 id="intro-h">Architecture first. Then we build the thing.</h2>
        </div>
        <div>
          <p>Our founder, Pranav Gore, has spent <strong>19 years</strong> designing systems that big organisations depend on: <strong>core banking integration</strong>, <strong>telecom order fulfilment</strong>, and a fleet of <strong>100+ automation robots</strong> at Telstra.</p>
          <p>At Studio Narrm we build the whole thing, fast, with <strong>AI-assisted development</strong>. Data pipelines, AI agents, dashboards, mobile apps and full platforms. Different problems, same habit: understand it properly, keep it simple, ship it.</p>
          <ul class="thumbs" aria-label="Jump to a service" style={`--cols:${SERVICES.length};--cols-sm:${SERVICES.length > 4 ? 3 : SERVICES.length}`}>
            {isShown("data-viz") && <li><a class="t-data" href="#data-viz" title="Data analytics &amp; visualisation"><svg viewBox="0 0 52 52" aria-hidden="true" focusable="false"><rect x="7" y="20" width="7" height="20" rx="2" class="s-tone"/><rect x="18" y="12" width="7" height="28" rx="2" class="s-tone"/><rect x="29" y="26" width="7" height="14" rx="2" class="s-tone"/><rect x="40" y="16" width="7" height="24" rx="2" class="s-tone"/></svg><span class="sr">Data analytics &amp; visualisation</span></a></li>}
            {isShown("automation") && <li><a class="t-rpa" href="#automation" title="Automation"><svg viewBox="0 0 52 52" aria-hidden="true" focusable="false"><rect x="12" y="18" width="28" height="22" rx="6" class="s-tone"/><circle cx="20" cy="29" r="3" fill="var(--bg)"/><circle cx="32" cy="29" r="3" fill="var(--bg)"/><rect x="24" y="12" width="4" height="6" class="s-tone"/></svg><span class="sr">Automation</span></a></li>}
            {isShown("agent-ready") && <li><a class="t-flow" href="#agent-ready" title="Prepare your business for agents"><svg viewBox="0 0 52 52" aria-hidden="true" focusable="false"><circle cx="8" cy="26" r="6" class="s-tone"/><circle cx="26" cy="16" r="6" class="s-tone"/><circle cx="44" cy="26" r="6" class="s-tone"/><circle cx="26" cy="38" r="6" class="s-tone"/><path d="M8 26 L26 16 L44 26 L26 38 Z" class="s-stroke-tone" stroke-width="2" fill="none"/></svg><span class="sr">Prepare your business for agents</span></a></li>}
            {isShown("custom-apps") && <li><a class="t-apps" href="#custom-apps" title="Custom apps"><svg viewBox="0 0 52 52" aria-hidden="true" focusable="false"><rect x="14" y="7" width="24" height="38" rx="5" class="s-tone"/><rect x="18" y="13" width="16" height="3" rx="1.5" fill="var(--bg)"/><rect x="18" y="20" width="16" height="3" rx="1.5" fill="var(--bg)"/><rect x="18" y="27" width="10" height="3" rx="1.5" fill="var(--bg)"/></svg><span class="sr">Custom apps</span></a></li>}
            {isShown("video-ads") && <li><a class="t-time" href="#video-ads" title="Video ads"><svg viewBox="0 0 52 52" aria-hidden="true" focusable="false"><rect x="8" y="12" width="36" height="28" rx="6" class="s-tone"/><path d="M22 19 L32 26 L22 33 Z" fill="var(--bg)"/></svg><span class="sr">Video ads</span></a></li>}
            {isShown("marketing-outreach") && <li><a class="t-yoga" href="#marketing-outreach" title="Marketing &amp; outreach"><svg viewBox="0 0 52 52" aria-hidden="true" focusable="false"><path d="M10 22 H18 L36 12 V40 L18 30 H10 Z" class="s-tone"/><path d="M40 20 Q45 26 40 32" class="s-stroke-tone" stroke-width="3" fill="none" stroke-linecap="round"/></svg><span class="sr">Marketing &amp; outreach</span></a></li>}
          </ul>
        </div>
      </div>
    </section>

    {SHOW_WHO && <section class="who" id="who" aria-labelledby="who-h">
      <div class="wrap">
        <span class="eyebrow">Who are you?</span>
        <h2 id="who-h">See yourself <em>as…</em></h2>
        <ul>
          <li><a class="t-data" href="/about/">A hiring manager</a></li>
          <li><a class="t-rpa" href="#automation">A bank or telco team</a></li>
          <li><a class="t-flow" href={isShown("marketing-outreach") ? "#marketing-outreach" : "#data-viz"}>A non-profit</a></li>
          <li><a class="t-apps" href="#agent-ready">A small business</a></li>
          <li><a class="t-time" href="#custom-apps">A founder with an idea</a></li>
          <li><a class="t-yoga" href={isShown("video-ads") ? "#video-ads" : "#custom-apps"}>A teacher or coach</a></li>
        </ul>
      </div>
    </section>}

    <section class="services-head" id="services" aria-labelledby="services-h">
      <div class="wrap">
        <span class="eyebrow">What we do</span>
        <h2 id="services-h">{NUM} ways we can help, one way of working</h2>
        <p>{isShown("video-ads") ? "Data, automation, AI agents, apps, video and outreach." : "Data, automation, AI agents and apps."} Different tools, same habit: understand the problem properly, build the simplest thing that works, and make sure it keeps working.</p>
        <ul class="services-nav">
          {SERVICES.map((sv) => <li><a class={sv.tone} href={"#" + sv.slug}>{sv.eyebrow}</a></li>)}
        </ul>
      </div>
    </section>

    {SERVICES.map((sv, i) => <ServicePanel s={sv} i={i} />)}

    <section class="served" aria-labelledby="served-h">
      <div class="wrap">
        <span class="eyebrow">Happily served</span>
        <h2 id="served-h">Industries, teams &amp; tools</h2>
      </div>
      <div class="marquee">
        <ul><li>Banking</li><li>Telecommunications</li><li>Telstra</li><li>Retail</li><li>Non-profit</li><li>n8n</li><li>AWS</li><li>Claude</li><li>Google AppSheet</li><li>PostgreSQL</li><li>Kafka</li><li>Spring Boot</li><li>Oracle OSM</li><li>Looker Studio</li><li>Docker</li></ul>
        <ul aria-hidden="true"><li>Banking</li><li>Telecommunications</li><li>Telstra</li><li>Retail</li><li>Non-profit</li><li>n8n</li><li>AWS</li><li>Claude</li><li>Google AppSheet</li><li>PostgreSQL</li><li>Kafka</li><li>Spring Boot</li><li>Oracle OSM</li><li>Looker Studio</li><li>Docker</li></ul>
      </div>
    </section>

        <section class="section" style="padding-top:0" aria-labelledby="how-h">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow">How we work</span>
            <h2 id="how-h">The brief, the mess, the deadline. Bring it.</h2>
          </div>
        </div>
        <ol class="steps">
          <li class="reveal"><span class="n">01</span><h3>Understand</h3><p>Map the process, the people and where the time goes.</p></li>
          <li class="reveal"><span class="n">02</span><h3>Design</h3><p>Architecture and data model, and the simplest path that works.</p></li>
          <li class="reveal"><span class="n">03</span><h3>Build</h3><p>Apps, integrations and agents, using AI to move fast.</p></li>
          <li class="reveal"><span class="n">04</span><h3>Automate</h3><p>Take people out of the copy-paste.</p></li>
          <li class="reveal"><span class="n">05</span><h3>Measure</h3><p>Dashboards that show whether it's working.</p></li>
        </ol>
      </div>
    </section>

    <section class="section faq" id="faq" aria-labelledby="faq-h">
      <div class="wrap">
        <div>
          <span class="eyebrow">Questions</span>
          <h2 id="faq-h">The quick answers</h2>
        </div>
        <div>
        <details open>
          <summary>Who is behind Studio Narrm?</summary>
          <p>Studio Narrm was founded by Pranav Gore, a Melbourne-based Solution Designer and Architect with 19 years of experience designing enterprise applications, system integrations, data analytics solutions and workflow automation across banking, telecommunications, retail and non-profit organisations.</p>
        </details>
        <details>
          <summary>What does Studio Narrm specialise in?</summary>
          <p>Solution architecture for complex enterprise systems: integration and microservices design, data migration and master data, analytics dashboards, and end-to-end workflow automation using n8n, AI agents built on large language models, AppSheet and AI-assisted development.</p>
        </details>
        <details>
          <summary>What has Studio Narrm's founder built end to end?</summary>
          <p>A data analytics web app, more than 50 n8n automations and AI agents, low-code AppSheet apps, the migration of more than 100 RPA robots in-house at Telstra, and two products in progress: the Stolen Minutes app and a platform for yoga teachers.</p>
        </details>
        <details>
          <summary>Which industries does Studio Narrm know?</summary>
          <p>Banking and financial services, telecommunications, retail and the non-profit sector. Pranav worked in client-facing roles on large transformation programmes with multiple vendors and geographies.</p>
        </details>
        <details>
          <summary>Can Studio Narrm build automation and analytics for a small team or non-profit?</summary>
          <p>Yes. We design and ship practical, low-maintenance solutions: self-hosted n8n data pipelines, AI agents that research and draft outreach, low-code operational apps and dashboards that turn scattered operational data into decisions.</p>
        </details>
        <details>
          <summary>Is Studio Narrm taking on projects?</summary>
          <p>Yes. We take on automation, data, AI agent, app and integration projects, including solution architecture and design engagements. We're based in Melbourne and happy to work remotely.</p>
        </details>
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-h">
      <div class="wrap">
        <div>
          <h2 id="contact-h">Ready to fix something? Tell us about it.</h2>
          <p>A project, or a process that's driving your team mad. We're in Melbourne and happy to work remotely.</p>
        </div>
        <form id="contact-form" novalidate>
          <label for="f-name">Your name<input id="f-name" name="name" autocomplete="name" required></label>
          <label for="f-email">Email<input id="f-email" name="email" type="email" autocomplete="email" required></label>
          <fieldset>
            <legend>What do you need?</legend>
            <label><input type="checkbox" name="need" value="A solution architect"> An architect</label>
            <label><input type="checkbox" name="need" value="Automation or AI agents"> Automation or AI</label>
            <label><input type="checkbox" name="need" value="A dashboard"> A dashboard</label>
            <label><input type="checkbox" name="need" value="An app or platform"> An app</label>
          </fieldset>
          <label for="f-msg">Tell us about it<textarea id="f-msg" name="message" required></textarea></label>
          <button class="btn" type="submit">Send via email</button>
          <p class="form-note" id="form-note">This opens your email app with your message filled in.</p>
        </form>
      </div>
    </section>
  </main>
<script is:inline slot="scripts" src="/assets/particle-network.js" defer></script>
<script is:inline slot="scripts">
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add('js');

    // Hero slider
    var slides = [].slice.call(document.querySelectorAll('.slide'));
    var dots = [].slice.call(document.querySelectorAll('.dots button'));
    var i = 0, timer = null;
    function show(n) {
      i = (n + slides.length) % slides.length;
      slides.forEach(function (s, k) { s.classList.toggle('on', k === i); s.setAttribute('aria-hidden', k === i ? 'false' : 'true'); });
      dots.forEach(function (d, k) { if (k === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
    }
    function play() { if (!reduce) { stop(); timer = setInterval(function () { show(i + 1); }, 4500); } }
    function stop() { if (timer) clearInterval(timer); timer = null; }
    dots.forEach(function (d, k) { d.addEventListener('click', function () { show(k); play(); }); });
    document.querySelectorAll('.arrows button').forEach(function (b) { b.addEventListener('click', function () { show(i + Number(b.dataset.dir)); play(); }); });
    var slider = document.querySelector('.slider');
    if (slider) { slider.addEventListener('mouseenter', stop); slider.addEventListener('mouseleave', play); }
    play();

    // Reveal: only elements below the fold start hidden
    if ('IntersectionObserver' in window && !reduce) {
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.remove('pending'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach(function (el) { if (el.getBoundingClientRect().top > window.innerHeight) { el.classList.add('pending'); io.observe(el); } });
    }

    // Contact form opens a prefilled email
    var form = document.getElementById('contact-form');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var note = document.getElementById('form-note');
      if (!form.checkValidity()) { note.textContent = 'Please add your name, a valid email and a short message.'; return; }
      var needs = [].slice.call(form.querySelectorAll('input[name=need]:checked')).map(function (c) { return c.value; }).join(', ');
      var body = form.message.value + '\n\n' + (needs ? 'Looking for: ' + needs + '\n' : '') + 'From: ' + form.name.value + ' <' + form.email.value + '>';
      window.location.href = 'mailto:pranavugore@gmail.com?subject=' + encodeURIComponent('Enquiry from ' + form.name.value) + '&body=' + encodeURIComponent(body);
      note.textContent = 'Your email app should open with the message ready to send. If nothing opens, set up an email app on this device and try again.';
    });
  })();
  </script>
</Base>
