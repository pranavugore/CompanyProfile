---
import { SITE } from "../data/site.js";
import Logo from "./Logo.astro";
const { current = "" } = Astro.props;
import { SERVICES } from "../data/services.js";
const isService = SERVICES.some((x) => x.slug === current);
const links = [
  { href: "/#services", label: "Services", key: isService ? current : "home" },
  { href: "/work/", label: "Case studies", key: "work" },
  { href: "/about/", label: "About", key: "about" },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={SITE.brand + " home"}><Logo id="logo-h" /></a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={current === l.key ? "page" : undefined}>{l.label}</a>)}
      <a class="btn small" href="/#contact">Start a project</a>
    </nav>
  </div>
</header>
